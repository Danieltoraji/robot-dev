/archive/
/datasets/
/reference code/

# release 打包产物（不入库）
/release/

# Python 缓存
__pycache__/
*.pyc

# 编辑器
.vscode/

# 真值集总图：由 tools/build_truth_matrix.py 生成（5310x3056），默认写
# archive/result/truth/。**不要**把它留在帧目录里——任何 glob('*.jpg') 的
# 工具都会把它当帧去检测，从而打乱真值集的 rank（曾因此让真值集整体失配）。
tests/fixtures/nine_grid_truth/truth_matrix.jpg

# 临时文件（提交信息/调试脚本，勿入库）
_cm.txt
_tmp_*.py
_tmp_code.py

# 本地会话计划：plan-sess_<uuid>.md 属会话过程产物，默认不入库
# （已跟踪的历史 plan 文件不受影响，git 对被跟踪文件忽略此规则；
#   确需入库时用 `git add -f` 显式点名，遵循"禁止 git add -A"的协作铁律）
